{
  "name": "jeviatus",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "git submodule update --init --recursive && cd vendor/OpenFrontIO && npm run inst",
    "server": "cd vendor/OpenFrontIO && npm run dev",
    "play": "bun harness/cli.ts",
    "build:extension": "bun scripts/build-extension.ts",
    "pin:openfront": "bun scripts/pin-openfront.ts",
    "site": "bun site/dev.ts",
    "build:site": "rm -rf dist/site && bun build site/index.html site/editor.html --outdir dist/site --minify --splitting",
    "preview:site": "bun run build:site && bun site/preview.ts",
    "test": "bun test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "esbuild": "0.28.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "6.0.3"
  }
}
