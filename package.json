{
  "name": "jeviatus",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "git submodule update --init --recursive && cd vendor/OpenFrontIO && npm ci --ignore-scripts --engine-strict=false",
    "server": "cd vendor/OpenFrontIO && npm run dev",
    "play": "bun harness/cli.ts",
    "build:extension": "bun scripts/build-extension.ts",
    "pin:openfront": "bun scripts/pin-openfront.ts",
    "site": "bun site/index.html site/editor.html",
    "build:site": "rm -rf dist/site && bun build site/index.html site/editor.html --outdir dist/site --minify --splitting",
    "test": "bun test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "trace-sink": "bun scripts/trace-sink.ts",
    "analyze": "bun scripts/analyze.ts",
    "improve": "bun scripts/improve.ts",
    "stream:up": "OPENFRONT_COMMIT=$(git -C vendor/OpenFrontIO rev-parse HEAD) HARNESS_COMMIT=$(git rev-parse HEAD)$(git diff --quiet HEAD -- . ':!vendor' || echo +dirty) docker compose -f stream/compose.yml up -d --build",
    "stream:logs": "docker compose -f stream/compose.yml logs -f --tail=100",
    "tiktok": "bun tiktok/cli.ts",
    "clips": "bun clips/cli.ts",
    "clips:watch": "bun clips/cli.ts --watch",
    "clips:start": "sh clips/watch-daemon.sh start",
    "clips:stop": "sh clips/watch-daemon.sh stop",
    "social:post": "bun social/post.ts",
    "stream:down": "docker compose -f stream/compose.yml down",
    "stream:mac": "STREAM_PLATFORM=mac bun stream/main.ts",
    "live": "bun stream/launch.ts",
    "deploy": "bash deploy/deploy.sh"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "esbuild": "0.28.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "6.0.3"
  }
}
