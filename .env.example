TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.13.0
# OPENFRONT_URL=http://localhost:9000
# DECISION_INTERVAL=15
# MIN_CONFIDENCE=0.35
# MAX_INTENTS_PER_STEP=5
# INTENTS_PER_MINUTE=140
# RUNS_DIR=runs

# --- 24/7 Kick + pump.fun stream (docker compose; see stream/README.md) ---
# Set one platform or both.
# Kick → Creator dashboard → Settings → Stream URL & Key
KICK_STREAM_URL=
KICK_STREAM_KEY=
# pump.fun → the coin's page → Start livestream → RTMP → Go Live
PUMPFUN_STREAM_URL=
PUMPFUN_STREAM_KEY=
# Bribes in the coin (read-only; no private key). Both addresses, or neither.
# BRIBE_MINT=
# BRIBE_WALLET=
# BRIBE_TICKER=JEV
# BRIBE_MIN=1
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# The on-screen commentator (stream/README.md#the-commentator)
# Kick channel whose chat he reads and answers (never posts):
# KICK_CHANNEL=jeviatus
# Claude writes his lines and answers chat; without it, canned lines:
# ANTHROPIC_API_KEY=
# His voice: ElevenLabs, else OpenAI, else macOS `say` (Mac), else subtitles only:
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
# COMMENTATOR=false turns him off
# Read-only token for the strategy ballot (5,000 GitHub API calls/h instead of 60)
GITHUB_TOKEN=
# BALLOT_REPO=alexandre-schaffner/jeviatus
# BALLOT_REQUIRE_APPROVAL=true
# BALLOT_MIN_VOTES=1
# JEV_USERNAME=jeviatus
# STREAM_WIDTH=1280
# STREAM_HEIGHT=720
# STREAM_FPS=30
# STREAM_VIDEO_KBPS=4500
# STREAM_AUDIO=true
# Every match's trace, for `bun run analyze` (on the /data volume):
# TRACE_DIR=/data/runs
# TRACE_PORT=9231
# Record to a file instead of going live (a dry run):
# STREAM_OUTPUT=/data/dry-run.mkv
# Rolling recording for TikTok clips (tiktok/README.md); ~2 GB per hour at 4500 kbps. 0 turns it off.
# STREAM_RECORD_HOURS=6
# STREAM_RECORD_DIR=/data/recordings
# Caption font for `bun run tiktok` (default: Impact if installed, else DejaVu Sans Bold)
# TIKTOK_FONT=/path/to/Anton-Regular.ttf
